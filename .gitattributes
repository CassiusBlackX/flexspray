# Use the following to delete tracked source files and replace them with LF endings
# git ls-files -z | xargs -0 rm
# git reset --hard

# Force LF endings to text files
* text=auto eol=lf

# Preserve raw command output in the atomic validation evidence.
.scratch/atomic-support/evidence/**/*.log -whitespace
.scratch/atomic-support/evidence/baseline/ClassName-*.txt -whitespace
.scratch/atomic-support/evidence/baseline/PrintUbGlobals.txt -whitespace
